---
// "/" has no content of its own: send visitors to their saved or preferred language.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Simon Yan</title>
    <link rel="canonical" href={new URL("/en/", Astro.site)} />
    <link rel="alternate" hreflang="en-US" href={new URL("/en/", Astro.site)} />
    <link rel="alternate" hreflang="zh-CN" href={new URL("/zh/", Astro.site)} />
    <script is:inline>
      (function () {
        var lang = null;
        try {
          lang = localStorage.getItem("lang");
        } catch (e) {}
        if (lang !== "en" && lang !== "zh") {
          var preferred = navigator.languages || [navigator.language || "en"];
          lang = String(preferred[0] || "en").toLowerCase().indexOf("zh") === 0 ? "zh" : "en";
        }
        location.replace("/" + lang + "/");
      })();
    </script>
    <noscript><meta http-equiv="refresh" content="0; url=/en/" /></noscript>
  </head>
  <body>
    <p><a href="/en/">English</a> · <a href="/zh/">中文</a></p>
  </body>
</html>
