---
import { cn } from "@lib/utils";
import type { Lang } from "@i18n/ui";

type Props = {
  lang: Lang;
  class?: string;
};

const { lang, class: className } = Astro.props;
---

<!-- Serif body text reads well in English; Chinese stays in sans-serif. -->
<article
  class={cn(
    "max-w-full prose dark:prose-invert prose-img:mx-auto prose-img:my-auto",
    "prose-headings:font-semibold prose-headings:text-black dark:prose-headings:text-white",
    lang === "en" && "prose-p:font-serif",
    className,
  )}
>
  <slot />
</article>
