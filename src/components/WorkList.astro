---
import { render, type CollectionEntry } from "astro:content";
import Prose from "@components/Prose.astro";
import { dateRange } from "@lib/utils";
import type { Lang } from "@i18n/ui";

type Props = {
  entries: CollectionEntry<"work">[];
  lang: Lang;
  animateItems?: boolean;
};

const { entries, lang, animateItems = false } = Astro.props;
const work = await Promise.all(
  entries.map(async (entry) => ({ ...entry, Content: (await render(entry)).Content })),
);
---

<ul class="flex flex-col space-y-4">
  {work.map((entry) => (
    <li class:list={[animateItems && "animate"]}>
      <div class="text-sm opacity-75">
        {dateRange(entry.data.dateStart, entry.data.dateEnd, lang)}
      </div>
      <div class="font-semibold text-black dark:text-white">
        {entry.data.company}
      </div>
      <div class="text-sm opacity-75">
        {entry.data.role}
      </div>
      <Prose lang={lang}>
        <entry.Content />
      </Prose>
    </li>
  ))}
</ul>
