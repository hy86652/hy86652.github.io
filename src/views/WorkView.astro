---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import WorkList from "@components/WorkList.astro";
import { t, type Lang } from "@i18n/ui";
import { getWork } from "@i18n/content";

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;
const work = await getWork(lang);
---

<PageLayout title={t(lang, "work.title")} description={t(lang, "work.description")} lang={lang}>
  <Container>
    <div class="space-y-10">
      <div class="animate space-y-2">
        <div class="font-semibold text-black dark:text-white">
          {t(lang, "work.title")}
        </div>
        <p class="text-sm">{t(lang, "work.description")}</p>
      </div>
      <WorkList entries={work} lang={lang} animateItems />
    </div>
  </Container>
</PageLayout>
