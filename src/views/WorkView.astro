---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import Timeline from "@components/Timeline.astro";
import { t, type Lang, type UIKey } from "@i18n/ui";
import { getTimeline } from "@i18n/content";

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;

const sections = [
  { heading: "work.experience", entries: await getTimeline("work", lang) },
  { heading: "work.education", entries: await getTimeline("education", lang) },
  { heading: "work.certifications", entries: await getTimeline("certifications", lang) },
  { heading: "work.awards", entries: await getTimeline("awards", lang) },
] satisfies { heading: UIKey; entries: unknown[] }[];
---

<PageLayout title={t(lang, "work.title")} description={t(lang, "work.description")} lang={lang}>
  <Container>
    <div class="space-y-10">
      <div class="animate space-y-2">
        <div class="font-semibold text-black dark:text-white">
          {t(lang, "work.title")}
        </div>
        <p class="text-sm">{t(lang, "work.description")}</p>
      </div>
      {sections.filter((section) => section.entries.length > 0).map((section) => (
        <section class="space-y-4">
          <h2 class="animate font-semibold text-black dark:text-white">
            {t(lang, section.heading)}
          </h2>
          <Timeline entries={section.entries} lang={lang} animateItems />
        </section>
      ))}
    </div>
  </Container>
</PageLayout>
